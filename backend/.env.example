# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-32bytes-min
PORT=5000

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default for local dev)
DATABASE_URL=sqlite:///nltk_toolkit.db

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Google OAuth (GIS popup/token flow - No Client Secret needed)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Rate Limiter
RATE_LIMIT_DEFAULT=100 per minute

# NLP Limits
MAX_INPUT_TEXT_LENGTH=50000

# Optional External Translation / LLM Provider (Default: 'mock' for tests / offline local fallback)
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=
REWRITING_PROVIDER=rule_based
REWRITING_API_KEY=
QA_PROVIDER=extractive
QA_API_KEY=
